html
    head
        meta(charset="utf-8")
        title Service Record
        style.
            * {
                font-family: Century Gothic, CenturyGothic, AppleGothic, sans-serif;
                color: #262626;
            }
            h2 {
                text-align: center;
                margin-bottom: 5px;
                text-transform: uppercase;
            }
            h3 {
                margin-top: 10px;
                font-size: 12px;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            td, th {
                border: 1px solid #000;
                padding: 5px 8px;
                vertical-align: top;
            }
            .noborder td {
                border: none;
                padding: 3px;
            }
            .label {
                width: 200px;
                font-weight: bold;
            }
            .signature {
                padding-top: 40px;
                text-align: center;
                font-style: italic;
            }
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 10px;
                margin-bottom: 10px;
            }
            .note {
                font-size: 10px;
                background-color: #f5f5f5;
                border-left: 3px solid #000;
                padding: 5px 10px;
            }
            input[type="checkbox"] {
                accent-color: black;
            }
            .services {
                width: 100%;
                border-collapse: collapse;
                margin-top: 15px;
            }
            .services th, .services td {
                border: 1px solid #000;
                padding: 2px;
                text-align: center;
                font-size: 11px;
            }
            .services th {
                background-color: #f5f5f5;
                font-weight: bold;
                text-transform: uppercase;
            }

    body
        table.noborder(style="width: 100%; margin-bottom: 10px;")
            td(style="width: 50%")
                img(style='width: 300px; height: auto;' src= seal)
            td(style="width: 50%;")
                div(style="background: #FAFAFA; text-align: center; font-size: 1.2em; text-transform: uppercase; padding: 20px; color: #7A1D1F;")
                    div(style="color: #7A1D1F;") service record
        div(style='text-transform: uppercase; font-weight: bold;')= name 
        div(style='text-transform: uppercase; font-size: 0.85em;')= position
        table.services
            thead
                tr
                    th(style="width: 15%;") Position
                    th(style="width: 10%;") Salary
                    th(style="width: 15%;") Employment status 
                    th(style="width: 10%;") Salary Type
                    th(style="width: 10%;") Salary Group 
                    th(style="width: 10%;") start date
                    th(style="width: 10%;") end date
                    th(style="width: 12%;") notes
            tbody
                each row in services
                    - const position = row.position;
                    - const salary = row.salary;
                    - const employment_status = row.employment_status;
                    - const salary_type = row.salary_type;
                    - const salary_group = row.salary_group;
                    - const start_date = moment(row.start_date).format("MMMM D, YYYY");
                    - const end_date = row.end_date ? moment(row.end_date).format("MMMM D, YYYY") : "Present";
                    - const notes = row.notes;
                    tr 
                        td(style='text-transform: uppercase;') #{position}
                        td #{new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' }).format(salary)}
                        td #{employment_status}
                        td(style='text-transform: capitalize;') #{salary_type}
                        td(style='text-transform: capitalize;') #{salary_group}
                        td #{start_date}
                        td #{end_date}
                        td #{notes}
        footer( style="position: fixed; bottom: 0; left: 0; right: 0;width: 100%; text-align: center; font-size: 10px; color: #333; padding-top: 5px; background-color: #fff; line-height: 1.3;")
            div(style="font-weight: bold; text-transform: uppercase;") Centurion Collection Management, Inc.
            div(style="margin-top: 3px;") © #{new Date().getFullYear()} All rights reserved.
            div(style="margin-top: 3px; font-size: 9px;") This document was system-generated. No signature is required.