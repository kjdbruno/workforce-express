html
    head
        meta(charset="utf-8")
        title Service Record
        style.
            * {
                font-family: Century Gothic, CenturyGothic, AppleGothic, sans-serif;
                color: #262626;
            }
            h2 {
                text-align: center;
                margin-bottom: 5px;
                text-transform: uppercase;
            }
            h3 {
                margin-top: 10px;
                font-size: 12px;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            td, th {
                border: 1px solid #000;
                padding: 5px 8px;
                vertical-align: top;
            }
            .noborder td {
                border: none;
                padding: 3px;
            }
            .label {
                width: 200px;
                font-weight: bold;
            }
            .signature {
                padding-top: 40px;
                text-align: center;
                font-style: italic;
            }
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 10px;
                margin-bottom: 10px;
            }
            .note {
                font-size: 10px;
                background-color: #f5f5f5;
                border-left: 3px solid #000;
                padding: 5px 10px;
            }
            input[type="checkbox"] {
                accent-color: black;
            }
            .services {
                width: 100%;
                border-collapse: collapse;
                margin-top: 15px;
            }
            .services th, .services td {
                border: 1px solid #000;
                padding: 2px;
                text-align: center;
                font-size: 11px;
            }
            .services th {
                background-color: #f5f5f5;
                font-weight: bold;
                text-transform: uppercase;
            }

    body
        table.noborder(style="width: 100%; margin-bottom: 10px;")
            td(style="width: 50%")
                img(style='width: 300px; height: auto;' src= seal)
            td(style="width: 50%;")
                div(style="background: #FAFAFA; text-align: center; font-size: 1.2em; text-transform: uppercase; padding: 20px; color: #7A1D1F;")
                    div(style="color: #7A1D1F;") service record
        table.services
            thead
                tr
                    th(style="width: 10%;") Position
                    th(style="width: 10%;") Salary
                    th(style="width: 10%;") Employment status 
                    th(style="width: 10%;") appointment status 
                    th(style="width: 10%;") start date
                    th(style="width: 10%;") end date
            tbody
                each row in services
                    - const position = row.salary.positions.name;
                    - const salary = row.rate.monthlyCompensation;
                    - const employmentStatus = row.employmentStatus.name;
                    - const appointmentStatus = row.appointmentStatus.name;
                    - const startDate = moment(row.dateStart).format("MMMM D, YYYY");
                    - const endDate = row.dateEnd ? moment(row.dateEnd).format("MMMM D, YYYY") : "Present";
                    tr 
                        td #{position}
                        td #{new Intl.NumberFormat('en-PH', { style: 'currency', currency: 'PHP' }).format(salary)}
                        td #{employmentStatus}
                        td #{appointmentStatus}
                        td #{startDate}
                        td #{endDate}
        footer( style="position: fixed; bottom: 0; left: 0; right: 0;width: 100%; text-align: center; font-size: 10px; color: #333; padding-top: 5px; background-color: #fff; line-height: 1.3;")
            div(style="font-weight: bold; text-transform: uppercase;") Centurion Collection Management, Inc.
            div(style="margin-top: 3px;") © #{new Date().getFullYear()} All rights reserved.
            div(style="margin-top: 3px; font-size: 9px;") This document was system-generated. No signature is required.