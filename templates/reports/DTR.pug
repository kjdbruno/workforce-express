html
    head
        meta(charset="utf-8")
        title Daily Time Record
        style.
            * {
                font-family: Century Gothic, CenturyGothic, AppleGothic, sans-serif;
                color: #262626;
            }
            h2 {
                text-align: center;
                margin-bottom: 5px;
                text-transform: uppercase;
            }
            h3 {
                margin-top: 10px;
                font-size: 12px;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            td, th {
                border: 1px solid #000;
                padding: 5px 8px;
                vertical-align: top;
            }
            .noborder td {
                border: none;
                padding: 3px;
            }
            .label {
                width: 200px;
                font-weight: bold;
            }
            .signature {
                padding-top: 40px;
                text-align: center;
                font-style: italic;
            }
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 10px;
                margin-bottom: 10px;
            }
            .note {
                font-size: 10px;
                background-color: #f5f5f5;
                border-left: 3px solid #000;
                padding: 5px 10px;
            }
            input[type="checkbox"] {
                accent-color: black;
            }
            .logs {
                width: 100%;
                border-collapse: collapse;
                margin-top: 15px;
            }
            .logs th, .logs td {
                border: 1px solid #000;
                padding: 2px;
                text-align: center;
                font-size: 11px;
            }
            .logs th {
                background-color: #f5f5f5;
                font-weight: bold;
            }
            .holiday {
                background-color: #ffe6e6;
            }
            .leave {
                background-color: #e6f3ff;
            }

    body
        table.noborder(style="width: 100%; margin-bottom: 10px;")
            td(style="width: 50%")
                img(style='width: 300px; height: auto;' src= seal)
            td(style="width: 50%;")
                div(style="background: #FAFAFA; text-align: center; font-size: 1.2em; text-transform: uppercase; padding: 20px; color: #7A1D1F;")
                    div(style="color: #7A1D1F;") daily time record
                    div(style="color: #7A1D1F;")= month
        table.logs
            thead
                tr
                th(style="width: 8%;") Date
                th(style="width: 12%;") Day
                th(style="width: 12%;") Time In
                th(style="width: 12%;") Time Out
                th(style="width: 10%;") Late
                th(style="width: 10%;") Undertime
                th(style="width: 10%;") Overtime
                th(style="width: 26%;") Remarks
            tbody
                each row in logs
                    - const dayName = moment(row.date).format("dddd");

                    // row.notes is array of objects: [{type, name/reason/...}]
                    - const notes = Array.isArray(row.notes) ? row.notes : [];
                    - const isHoliday = notes.some(n => n.type === 'holiday');
                    - const isLeave = notes.some(n => n.type === 'leave');

                    // Build remarks text
                    - const remarksArr = [];
                    - notes.forEach(n => {
                    -   if (n.type === 'holiday') remarksArr.push('* Holiday');
                    -   else if (n.type === 'leave') remarksArr.push(`* ${n.name}`);
                    -   else if (n.type === 'overtime') remarksArr.push('* Overtime');
                    -   else if (n.type === 'adjustment') remarksArr.push('* Adjusted time-in/out');
                    - });
                    - const remarks = remarksArr.join(", ");


                    - const formatTimeAMPM = (t) => {
                    -   if (!t) return '';
                    -   return moment(t, ['HH:mm', 'HH:mm:ss']).format('h:mm A');
                    - };

                    - const formatMinutesDHM = (value) => {
                    -   const total = Number(value) || 0;
                    -   if (total <= 0) return ''; // ✅ do NOT reflect 0 mins
                    -
                    -   const dayMins = 24 * 60; // change to 8*60 if needed
                    -   const days = Math.floor(total / dayMins);
                    -   const hours = Math.floor((total % dayMins) / 60);
                    -   const minutes = total % 60;
                    -
                    -   const parts = [];
                    -   if (days) parts.push(`${days} ${days === 1 ? 'day' : 'days'}`);
                    -   if (hours) parts.push(`${hours} ${hours === 1 ? 'hr' : 'hrs'}`);
                    -   if (minutes) parts.push(`${minutes} ${minutes === 1 ? 'min' : 'mins'}`);
                    -
                    -   return parts.join(' ');
                    - };



                    tr(class=(isHoliday ? 'holiday' : isLeave ? 'leave' : ''))
                        td #{moment(row.date).format("DD")}
                        td #{dayName}
                        td #{formatTimeAMPM(row.time_in)}
                        td #{formatTimeAMPM(row.time_out)}
                        td #{formatMinutesDHM(row.late)}
                        td #{formatMinutesDHM(row.undertime)}
                        td #{formatMinutesDHM(row.overtime)}
                        td(style="text-align:left; font-size: .4em; font-style: italic; text-transform: uppercase; padding-top: 5px;") #{remarks}
        table.noborder
            tr 
                each s, index in signatories
                    td(style='padding: 0px 20px 0px 20px')
                        div(style="text-align: center; margin-top: 15px;")
                            div(style='text-transform: capitalize; font-size: 10px;') #{s.description}
                            div(style="margin-top: 25px; border-bottom: 1px solid #000; padding-bottom: 3px; width: 100%; text-align: center;") 
                                if s.isSigned
                                    img(style='width: 100px; height: auto; position: relative; margin-bottom: 5px;' src=s.signature)
                                else
                                    div(style="height: 50px; line-height: 50px; font-style: italic; color: #666;") Unsigned
                                div(style="font-size: 12px; text-transform: uppercase; font-weight: bold;") #{s.approver}
                            div(style="width: 100%; text-align: center; font-size: 11px; text-transform: capitalize;") #{s.position}
                            div(style="width: 100%; text-align: center; font-size: 9px; text-transform: capitalize; font-style: italic;") signed: #{s.date}
        footer( style="position: fixed; bottom: 0; left: 0; right: 0;width: 100%; text-align: center; font-size: 10px; color: #333; padding-top: 5px; background-color: #fff; line-height: 1.3;")
            div(style="font-weight: bold; text-transform: uppercase;") Centurion Collection Management, Inc.
            div(style="margin-top: 3px;") © #{new Date().getFullYear()} All rights reserved.
            div(style="margin-top: 3px; font-size: 9px;") This document was system-generated. No signature is required.