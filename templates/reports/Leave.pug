html
    head
        meta(charset="utf-8")
        title Leave Form
        style.
            * {
                font-family: Century Gothic, CenturyGothic, AppleGothic, sans-serif;
                color: #262626;
            }
            h2 {
                text-align: center;
                margin-bottom: 5px;
                text-transform: uppercase;
            }
            h3 {
                margin-top: 10px;
                font-size: 12px;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            td, th {
                border: 1px solid #000;
                padding: 5px 8px;
                vertical-align: top;
            }
            .noborder td {
                border: none;
                padding: 3px;
            }
            .label {
                width: 200px;
                font-weight: bold;
            }
            .signature {
                padding-top: 40px;
                text-align: center;
                font-style: italic;
            }
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 10px;
                margin-bottom: 10px;
            }
            .note {
                font-size: 10px;
                background-color: #f5f5f5;
                border-left: 3px solid #000;
                padding: 5px 10px;
            }
            input[type="checkbox"] {
                accent-color: black;
            }
            .leaves {
                width: 100%;
                border-collapse: collapse;
                margin-top: 15px;
            }
            .leaves th, .leaves td {
                border: 1px solid #000;
                padding: 2px;
                font-size: 11px;
            }
            .leaves th {
                background-color: #f5f5f5;
                font-weight: bold;
            }
            .holiday {
                background-color: #ffe6e6;
            }
            .leave {
                background-color: #e6f3ff;
            }

    body
        table.noborder(style="width: 100%; margin-bottom: 10px;")
            td(style="width: 50%;")
                img(style='width: 300px; height: auto;' src= seal)
            td(style="width: 50%;")
                div(style="background: #FAFAFA; text-align: center; font-size: 1.2em; text-transform: uppercase; padding: 20px; color: #7A1D1F;")
                    div(style="color: #7A1D1F;") leave form
        table.leaves
            tbody
                tr
                    td(style="width: 50%;")
                        span(style="font-weight: bold; margin-bottom: 8px;") Employee Name:&nbsp;
                        span #{name}
                    td(style="width: 50%;")
                        span(style="font-weight: bold; margin-bottom: 8px;") Date Filed:&nbsp;
                        span #{dateFiled}
                tr
                    td(style="width: 50%;") 
                        span(style="font-weight: bold; margin-bottom: 8px;") Company:&nbsp;
                        span #{company}
                    td(style="width: 50%;")
                        span(style="font-weight: bold; margin-bottom: 8px;") Department/Position:&nbsp;
                        span #{departmentPosition}

                tr
                    td(colspan="2" style="width: 100%;")
                        span(style="font-weight: bold; margin-bottom: 8px;") Contact Number:&nbsp;
                        span #{contactNo}
                tr 
                    td(style="width: 50%;")
                        each lt in leaves
                            div(style="display:block; margin-bottom:4px;")
                                input(type="checkbox" name="leaveTypes[]" value=lt.id checked=lt.active)
                                label(for="leaveTypes[]") #{lt.name}
                        div(style="margin-top: 25px;")
                            span(style="font-weight: bold;") Total Days:&nbsp;
                            span #{totalDays}
                        div 
                            span(style="font-weight: bold;") Leave Period:&nbsp;
                            span #{leaveStart} to #{leaveEnd}
                        div 
                            span(style="font-weight: bold;") Status:&nbsp;
                            span #{status}
                    td(style="padding: 0px 20px 10px 20px; width: 50%;")
                        each s, index in signatories
                            div(style="text-align: center; margin-top: 15px;")
                                div #{s.signatoryName}
                                div(style="margin-top: 25px; border-bottom: 1px solid #000; padding-bottom: 3px; width: 100%; text-align: center;") 
                                    if s.isSigned
                                        img(style='width: 100px; height: auto; position: relative; margin-bottom: 5px;' src=s.signature)
                                    else
                                        div(style="height: 50px; line-height: 50px; font-style: italic; color: #666;") Unsigned
                                    div(style="font-size: 12px; text-transform: uppercase; font-weight: bold;") #{s.userName}
                                div(style="width: 100%; text-align: center; font-size: 11px;") #{s.position}
                                div(style="width: 100%; text-align: center; font-size: 10px;") #{s.date}
                tr 
                    td(colspan="2" style="width: 100%;")
                        div(style="font-weight: bold; margin-bottom: 5px;") Reason for Leave:
                        div= reason

        table.leave-balance(style="width:100%; border-collapse:collapse; font-size:0.7em; text-align:center;")
            thead
                tr
                    td(
                        colspan=balance.length + 1
                        style="border:1px solid #000; font-weight:bold; text-align:left; padding:4px;"
                    ) Leave Balances

            tbody
                tr
                    td(style="border:1px solid #000; font-weight:bold; text-align:left;") Leave Type
                    each lb in balance
                        td(style="border:1px solid #000;") #{lb.leaveType}
                tr
                    td(style="border:1px solid #000; font-weight:bold; text-align:left;") Used
                    each lb in balance
                        td(style="border:1px solid #000;") #{lb.used}
                tr
                    td(style="border:1px solid #000; font-weight:bold; text-align:left;") Balance
                    each lb in balance
                        td(style="border:1px solid #000; font-weight:bold;") #{lb.balance}

        footer( style="position: fixed; bottom: 0; left: 0; right: 0;width: 100%; text-align: center; font-size: 10px; color: #333; padding-top: 5px; background-color: #fff; line-height: 1.3;")
            div(style="font-weight: bold; text-transform: uppercase;") Centurion Collection Management, Inc.
            div(style="margin-top: 3px;") © #{new Date().getFullYear()} All rights reserved.
            div(style="margin-top: 3px; font-size: 9px;") This document was system-generated. No signature is required.