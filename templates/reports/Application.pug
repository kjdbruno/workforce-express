html
    head
        meta(charset="utf-8")
        title Application Form
        style.
            * {
                font-family: Century Gothic, CenturyGothic, AppleGothic, sans-serif;
                color: #262626;
            }
            h2 {
                text-align: center;
                margin-bottom: 5px;
                text-transform: uppercase;
            }
            h3 {
                margin-top: 10px;
                font-size: 12px;
            }
            table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 10px;
            }
            td, th {
                border: 1px solid #000;
                padding: 5px 8px;
                vertical-align: top;
            }
            .noborder td {
                border: none;
                padding: 3px;
            }
            .label {
                width: 200px;
                font-weight: bold;
            }
            .signature {
                padding-top: 40px;
                text-align: center;
                font-style: italic;
            }
            .header {
                display: flex;
                justify-content: space-between;
                align-items: center;
                font-size: 10px;
                margin-bottom: 10px;
            }
            .note {
                font-size: 10px;
                background-color: #f5f5f5;
                border-left: 3px solid #000;
                padding: 5px 10px;
            }
            input[type="checkbox"] {
                accent-color: black;
            }

    body
        table.noborder(style="width: 100%; margin-bottom: 10px;")
            td(style="width: 50%")
                img(style='width: 300px; height: auto;' src= seal)
            td(style="width: 50%;")
                div(style="background: #FAFAFA; text-align: center; font-size: 1.2em; text-transform: uppercase; padding: 20px; color: #7A1D1F;") application form
        .header
            div
            div CONTROL NO.:
                span(style="text-decoration: underline;")= controlNo
        h3(style='text-transform: uppercase;') 1. Applicant Profile
        table(style="font-size: 10px;")
            tr
                td(style="width: 25%; text-transform: uppercase;").label Full Name:
                td(style="width: 25%; text-transform: capitalize;")= name
                td(style="width: 25%; text-transform: uppercase;").label Sex:
                td(style="width: 25%; text-transform: capitalize;")= sex
            tr
                td(style="width: 25%; text-transform: uppercase;").label Civil Status:
                td(style="width: 25%;")= maritalStatus
                td(style="width: 25%; text-transform: uppercase;").label Birthdate:
                td(style="width: 25%;")= birthdate
            tr
                td(style="width: 25%; text-transform: uppercase;").label Address:
                td(colspan='3' style="width: 75%; text-transform: capitalize;")= address
            tr
                td(style="width: 25%; text-transform: uppercase;").label Birthplace:
                td(colspan='3' style="width: 25%; text-transform: capitalize;")= birthplace
            tr
                td(style="width: 25%; text-transform: uppercase;").label Email Address:
                td(style="width: 25%;")= email
                td(style="width: 25%; text-transform: uppercase;").label Contact No.:
                td(style="width: 25%;")= contactNo
        h3(style='text-transform: uppercase;') 2. Education Information
        table(style="font-size: 10px;")
            tr
                td(style="text-transform: uppercase").label Level
                td(style="text-transform: uppercase").label School
                td(style="text-transform: uppercase").label Degree
                td(style="text-transform: uppercase").label Start Date
                td(style="text-transform: uppercase").label End Date
            each e, index in educations
                tr
                    td(style="text-transform: capitalize;") #{e.level}
                    td(style="text-transform: capitalize;") #{e.school}
                    td(style="text-transform: capitalize;") #{e.course}
                    td(style="text-transform: capitalize;") #{e.startDate}
                    td(style="text-transform: capitalize;") #{e.endDate}
        h3(style='text-transform: uppercase;') 3. Training Information
        table(style="font-size: 10px;")
            tr
                td(style="text-transform: uppercase;").label Title
                td(style="text-transform: uppercase;").label Training Type
                td(style="text-transform: uppercase;").label Start Date
                td(style="text-transform: uppercase;").label End Date
                td(style="text-transform: uppercase;").label Hour/s
            each t, index in trainings
                tr
                    td(style="text-transform: capitalize;") #{t.title}
                    td(style="text-transform: capitalize;") #{t.type}
                    td(style="text-transform: capitalize;") #{t.startDate}
                    td(style="text-transform: capitalize;") #{t.endDate}
                    td(style="text-transform: capitalize;") #{t.hours}
        h3(style='text-transform: uppercase;') 4. Experience Information
        table(style="font-size: 10px;")
            tr
                td(style="text-transform: uppercase;").label Position
                td(style="text-transform: uppercase;").label Job Description
                td(style="text-transform: uppercase;").label Start Date
                td(style="text-transform: uppercase;").label End Date
            each e, index in experiences
                tr
                    td(style="text-transform: capitalize;") #{e.position}
                    td(style="text-transform: capitalize;") #{e.jobDescription}
                    td(style="text-transform: capitalize;") #{e.startDate}
                    td(style="text-transform: capitalize;") #{e.endDate}
        h3(style='text-transform: uppercase;') 5. Submitted Documents
        table(style="font-size: 10px;")
            each e, index in documents
                tr
                    td #{e.filename}
        footer( style="position: fixed; bottom: 0; left: 0; right: 0;width: 100%; text-align: center; font-size: 10px; color: #333; padding-top: 5px; background-color: #fff; line-height: 1.3;")
            div(style="font-weight: bold; text-transform: uppercase;") Centurion Collection Management, Inc.
            div(style="margin-top: 3px;") © #{new Date().getFullYear()} All rights reserved.
            div(style="margin-top: 3px; font-size: 9px;") This document was system-generated. No signature is required.

